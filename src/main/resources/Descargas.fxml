<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      prefHeight="550.0"
      prefWidth="750.0"
      spacing="15.0"
      style="-fx-background-color: #031838;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.PrincipalController">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <children>

        <Label alignment="CENTER"
               maxWidth="1.7976931348623157E308"
               text="Gestión de Base de Datos - `its5a`"
               textFill="WHITE">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
            <VBox.margin>
                <Insets bottom="5.0"/>
            </VBox.margin>
        </Label>

        <Label alignment="CENTER_LEFT"
               maxWidth="1.7976931348623157E308"
               text="Listado Completo de Tablas para Descarga"
               textFill="#8bb4f6">
            <font>
                <Font name="System Bold" size="15.0"/>
            </font>
        </Label>

        <ListView fx:id="listaTablas"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #031838; -fx-control-inner-background: #031838; -fx-border-color: #2a52be; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: white;">

            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="roles"/>
                    <String fx:value="usuarios"/>
                    <String fx:value="productos"/>
                    <String fx:value="pedidos"/>
                    <String fx:value="clientes"/>
                    <String fx:value="ventas"/>
                    <String fx:value="proveedores"/>
                    <String fx:value="inventario"/>
                    <String fx:value="logins"/>
                </FXCollections>
            </items>
        </ListView>

        <Label fx:id="lblEstado"
               text=""
               textFill="#8bb4f6"
               visible="false"
               managed="false"/>

        <HBox alignment="CENTER" spacing="15.0">
            <children>

                <Button fx:id="btnDescargar"
                        onAction="#descargar"
                        HBox.hgrow="ALWAYS"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="45.0"
                        style="-fx-background-color: #2575fc; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Descargar Tabla Seleccionada">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Button>

                <Button fx:id="btnVerDescargadas"
                        onAction="#verDescargadas"
                        HBox.hgrow="ALWAYS"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="45.0"
                        style="-fx-background-color: #2575fc; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Ver descargadas">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Button>

                <Button fx:id="btnSalir"
                        onAction="#salir"
                        HBox.hgrow="ALWAYS"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="45.0"
                        style="-fx-background-color: #2575fc; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Salir">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Button>

            </children>

            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HBox>

    </children>
</VBox>
